# ==================================================
# Nexora Backend - Environment Configuration Template
# Copy this file to .env and fill in your values
# ==================================================

# =================== SERVER ======================
PORT=5000
NODE_ENV=development

# ================= MONGODB ATLAS =================
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/nexora?retryWrites=true&w=majority&appName=Cluster0

# =================== JWT ==========================
JWT_SECRET=your_super_secret_jwt_access_key_here_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here_min_32_chars

# Token Expiry (optional, defaults to 15m and 7d)
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ============== FACULTY SECRET KEY ===============
# Required during Faculty Registration
FACULTY_SECRET_KEY=NEXORAneelpatel2026

# ============== GOOGLE GEMINI AI =================
# Get your key from https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# ============= FIREBASE CLOUD MESSAGING ==========
# Paste the entire Firebase Admin SDK service account JSON as a single line (minified)
# Get from Firebase Console > Project Settings > Service Accounts > Generate Private Key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ================= EMAIL / SMTP ===================
# For password reset emails (e.g. Gmail, SendGrid, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# ============== FRONTEND BASE URL ================
# Used for constructing password reset links in emails
FRONTEND_URL=http://localhost:5000
